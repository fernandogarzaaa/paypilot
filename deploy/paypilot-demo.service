[Unit]
Description=PayPilot demo (mock PayPal backend)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/paypilot-demo
EnvironmentFile=/home/ec2-user/paypilot-demo.env
ExecStart=/home/ec2-user/paypilot-demo/.venv/bin/uvicorn paypilot.web:app --host 0.0.0.0 --port 8931
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
