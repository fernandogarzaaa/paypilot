# Environment variables read by PayPilot. Copy to .env and fill in as needed.
# No values are committed here on purpose.

# PayPal backend: "mock" uses the in-process mock transport (tests/demos)
PAYPILOT_TRANSPORT=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_MODE=

# Agent model (OpenAI-compatible endpoint)
PAYPILOT_MODEL_BASE_URL=
PAYPILOT_MODEL_API_KEY=
PAYPILOT_MODEL_ID=

# Servers
PAYPILOT_MCP_HOST=
PAYPILOT_MCP_PORT=
PAYPILOT_WEB_HOST=
PAYPILOT_WEB_PORT=

# scripts/sandbox-smoke.py: optional real sandbox capture id for refund smoke test
PAYPAL_SMOKE_CAPTURE_ID=
